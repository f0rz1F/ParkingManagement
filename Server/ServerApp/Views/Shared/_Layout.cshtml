<!DOCTYPE html>
<html lang="uk" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Адмін-панель</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/dark-theme.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/Admin">
                    <i class="bi bi-p-square-fill fs-4"></i>
                    <span>Парковка — Адмін</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/Admin"><i class="bi bi-speedometer2 me-1"></i> Головна</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Attendants"><i class="bi bi-people me-1"></i> Працівники</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/ParkingSpots"><i class="bi bi-car-front me-1"></i> Паркомісця</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Reservations"><i class="bi bi-calendar-check me-1"></i> Бронювання</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-white-50 small"><i class="bi bi-person-circle me-1"></i> @User.Identity?.Name</span>
                        <a href="/auth/logout" class="btn btn-sm btn-outline-light">
                            <i class="bi bi-box-arrow-right me-1"></i> Вийти
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container mb-5">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 border-top text-center text-muted small">
        <div class="container">
            &copy; 2026 — Система управління парковкою (Варіант 4)
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
