@model ServerApp.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="uk" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Вхід до адмін-панелі — Парковка</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/dark-theme.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-card">
        <h4 class="text-center mb-1 fw-bold">Система парковки</h4>
        <p class="text-center text-muted mb-4">Вхід до панелі адміністратора</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form action="/auth/login" method="post">
            <div class="mb-3">
                <label for="Email" class="form-label">Електронна пошта</label>
                <input type="email" class="form-control" id="Email" name="Email" value="@(Model?.Email ?? "admin@parking.com")" required />
            </div>

            <div class="mb-3">
                <label for="Password" class="form-label">Пароль</label>
                <input type="password" class="form-control" id="Password" name="Password" value="AdminPassword123!" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 mt-2">Увійти</button>
        </form>

        <div class="mt-4 pt-3 border-top text-center small text-muted">
            Дані за замовчуванням:<br />
            <code>admin@parking.com</code> / <code>AdminPassword123!</code>
        </div>
    </div>
</body>
</html>