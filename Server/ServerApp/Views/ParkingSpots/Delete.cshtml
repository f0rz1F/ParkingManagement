@model ServerApp.Models.ParkingSpot

@{
    ViewData["Title"] = "Видалити паркомісце";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Підтвердження видалення</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-muted">Ви дійсно бажаєте видалити це паркувальне місце? Всі пов'язані бронювання також будуть видалені.</p>

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">ID:</span>
                        <span class="fw-bold">#@Model.ID</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Номер місця:</span>
                        <span class="badge bg-dark fs-6">№ @Model.Number</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Статус:</span>
                        <span>@Model.Status</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Закріплений працівник:</span>
                        <span>@(Model.Attendant?.Name ?? "Не закріплено")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Пов'язаних бронювань:</span>
                        <span class="badge bg-secondary">@Model.Reservations.Count</span>
                    </li>
                </ul>

                <form asp-action="Delete" asp-route-id="@Model.ID" method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="ID" />
                    <a asp-action="Index" class="btn btn-light">Скасувати</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i> Так, видалити
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
