@model ServerApp.Models.ParkingSpot

@{
    ViewData["Title"] = "Створити паркомісце";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h3 class="fw-bold mb-0">Створити нове паркомісце</h3>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> До списку
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Number" class="form-label fw-semibold">Номер місця</label>
                        <input asp-for="Number" type="number" min="1" class="form-control" placeholder="Наприклад, 15" required />
                        <span asp-validation-for="Number" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">Статус місця</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Free">Вільне (Free)</option>
                            <option value="Occupied">Зайняте (Occupied)</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="UserID" class="form-label fw-semibold">Закріплений працівник</label>
                        <select asp-for="UserID" class="form-select" asp-items="ViewBag.UserID">
                            <option value="">-- Без закріплення --</option>
                        </select>
                        <span asp-validation-for="UserID" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Скасувати</a>
                        <button type="submit" class="btn btn-info text-white px-4">
                            <i class="bi bi-check-lg me-1"></i> Створити
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
