@{
    ViewData["Title"] = "Головна панель";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Панель управління системою</h2>
        <p class="text-muted mb-0">Керування працівниками, паркувальними місцями та бронюваннями</p>
    </div>
    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6">
        <i class="bi bi-shield-check me-1"></i> Адміністратор активний
    </span>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-start border-primary border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold">Працівники</span>
                    <div class="bg-primary-subtle text-primary rounded-circle p-2">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">@ViewBag.AttendantsCount</h3>
                <p class="text-muted small mb-3">Всього зареєстрованих працівників</p>
                <a href="/Attendants" class="btn btn-outline-primary btn-sm w-100">
                    <i class="bi bi-arrow-right-circle me-1"></i> Перейти до списку
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-start border-info border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold">Паркувальні місця</span>
                    <div class="bg-info-subtle text-info rounded-circle p-2">
                        <i class="bi bi-car-front fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">@ViewBag.SpotsCount</h3>
                <p class="text-muted small mb-3">Вільних місць: <strong class="text-success">@ViewBag.FreeSpotsCount</strong></p>
                <a href="/ParkingSpots" class="btn btn-outline-info btn-sm w-100">
                    <i class="bi bi-arrow-right-circle me-1"></i> Керувати місцями
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-start border-warning border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold">Бронювання</span>
                    <div class="bg-warning-subtle text-warning rounded-circle p-2">
                        <i class="bi bi-calendar-check fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">@ViewBag.ReservationsCount</h3>
                <p class="text-muted small mb-3">Активних бронювань: <strong class="text-warning">@ViewBag.ActiveReservationsCount</strong></p>
                <a href="/Reservations" class="btn btn-outline-warning btn-sm w-100">
                    <i class="bi bi-arrow-right-circle me-1"></i> Журнал бронювань
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Швидкі дії</h5>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Attendants/Create" class="btn btn-primary btn-sm">
                <i class="bi bi-person-plus me-1"></i> Додати працівника
            </a>
            <a href="/ParkingSpots/Create" class="btn btn-info btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Створити паркомісце
            </a>
            <a href="/Reservations/Create" class="btn btn-warning btn-sm">
                <i class="bi bi-calendar-plus me-1"></i> Нове бронювання
            </a>
        </div>
    </div>
</div>