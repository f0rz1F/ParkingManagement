@model ServerApp.Models.Attendant

@{
    ViewData["Title"] = "Додати працівника";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h3 class="fw-bold mb-0">Додати нового працівника</h3>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> До списку
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Повне ім'я</label>
                        <input asp-for="Name" class="form-control" placeholder="Наприклад, Олексій Іваненко" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Електронна пошта</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="name@parking.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold">Початковий пароль</label>
                        <input type="password" id="password" name="password" class="form-control" placeholder="Залиште порожнім для паролю за замовчуванням" />
                        <div class="form-text">Якщо не вказати, буде використано пароль за замовчуванням.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Скасувати</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Створити
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
