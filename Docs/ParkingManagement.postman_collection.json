{
  "info": {
    "name": "ParkingManagement API",
    "description": "Postman колекція для тестування REST API ParkingManagement (Варіант 4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5088",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login (Аутентифікація Sasha Yaschenko)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('jwt_token', jsonData.token);",
              "}",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sasha@parking.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "2. Get Parking Spots (Отримання списку місць з Bearer токеном)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items"
          ]
        }
      }
    },
    {
      "name": "3. Unauthorized Check (Спроба доступу без токена - 401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items"
          ]
        }
      }
    },
    {
      "name": "4. Create Reservation (Бронювання місця №6)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"spotId\": 6\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/actions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "actions"
          ]
        }
      }
    },
    {
      "name": "5. Cancel Reservation (Скасування бронювання місця №6)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/actions/6",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "actions",
            "6"
          ]
        }
      }
    }
  ]
}
