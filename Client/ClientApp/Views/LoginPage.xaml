<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClientApp.ViewModels"
             x:Class="ClientApp.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            
            <!-- Заголовок та іконка -->
            <Border StrokeShape="RoundRectangle 24" BackgroundColor="{StaticResource AccentBg}" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                <Label Text="P" TextColor="{StaticResource AccentText}" FontSize="38" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>

            <Label Text="Система парковки" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextPrimary}" />
            <Label Text="Вхід для працівників (.NET MAUI)" FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" Margin="0,-10,0,10" />

            <!-- Картка з формою логіну -->
            <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource Surface}" Padding="24">
                <VerticalStackLayout Spacing="16">
                    
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Електронна пошта" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource InputBorder}" BackgroundColor="{StaticResource Surface2}" Padding="12,0">
                            <Entry Text="{Binding Email}" Placeholder="sasha@parking.com" Keyboard="Email" ReturnType="Next" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextMuted}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Пароль" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource InputBorder}" BackgroundColor="{StaticResource Surface2}" Padding="12,0">
                            <Entry Text="{Binding Password}" Placeholder="Введіть пароль" IsPassword="True" ReturnType="Done" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextMuted}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Повідомлення про помилку -->
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource DangerColor}" FontSize="13" HorizontalTextAlignment="Center" />

                    <!-- Індикатор завантаження -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource TextPrimary}" HeightRequest="30" />

                    <!-- Кнопка входу -->
                    <Button Text="Увійти до системи" Command="{Binding LoginCommand}" BackgroundColor="{StaticResource AccentBg}" TextColor="{StaticResource AccentText}" CornerRadius="10" HeightRequest="48" FontAttributes="Bold" FontSize="15" />

                </VerticalStackLayout>
            </Border>

            <!-- Підказка для тестування -->
            <Label Text="Тестові дані: sasha@parking.com / Password123!" FontSize="12" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
