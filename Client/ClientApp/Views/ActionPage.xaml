<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClientApp.ViewModels"
             x:Class="ClientApp.Views.ActionPage"
             x:DataType="vm:ActionViewModel"
             Title="Бронювання місця"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

            <!-- Заголовок сторінки -->
            <Label Text="Підтвердження бронювання" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextPrimary}" />
            <Label Text="Створення нового запису в системі парковки" FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" Margin="0,-12,0,8" />

            <!-- Картка з інформацією про вибране місце -->
            <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource Surface}" Padding="24">
                <VerticalStackLayout Spacing="16">

                    <!-- Бейдж номера місця -->
                    <Border StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource AccentBg}" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center">
                        <Label Text="{Binding SelectedSpot.Number}" TextColor="{StaticResource AccentText}" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>

                    <Label Text="{Binding SelectedSpot.Number, StringFormat='Паркомісце № {0}'}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextPrimary}" />

                    <!-- Деталі місця -->
                    <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource Surface2}" Padding="14">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Поточний статус:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                                <Label Grid.Column="1" Text="{Binding SelectedSpot.DisplayStatus}" TextColor="{Binding SelectedSpot.StatusBadgeColor}" FontAttributes="Bold" FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding SelectedSpot.HasAttendant}">
                                <Label Grid.Column="0" Text="Закріплений працівник:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                                <Label Grid.Column="1" Text="{Binding SelectedSpot.AttendantName}" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" FontSize="13" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Опис дії -->
                    <Label Text="Після підтвердження на сервері буде створено нове активне бронювання для вашого облікового запису." FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />

                    <!-- Повідомлення про стан виконання -->
                    <Label Text="{Binding StatusMessage}" TextColor="{StaticResource DangerColor}" FontSize="13" HorizontalTextAlignment="Center" />

                    <!-- Індикатор завантаження -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource TextPrimary}" HeightRequest="30" />

                    <!-- Кнопка створення бронювання -->
                    <Button Text="Підтвердити бронювання"
                            Command="{Binding MakeReservationCommand}"
                            BackgroundColor="{StaticResource AccentBg}"
                            TextColor="{StaticResource AccentText}"
                            CornerRadius="10"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            FontSize="15" />

                    <!-- Кнопка скасування -->
                    <Button Text="Скасувати"
                            Command="{Binding CancelCommand}"
                            BackgroundColor="{StaticResource Surface3}"
                            TextColor="{StaticResource TextPrimary}"
                            BorderColor="{StaticResource InputBorder}"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="44"
                            FontAttributes="Bold"
                            FontSize="14" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
